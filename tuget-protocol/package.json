{
  "name": "@tuget/protocol",
  "version": "0.2.2",
  "description": "TuGet desktop, Pro-GetPic desktop extension and Native Host communication contract.",
  "type": "module",
  "private": true,
  "files": [
    "dist/src",
    "dist/schema",
    "dist/source-fingerprint.json",
    "schema",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./identity": {
      "types": "./dist/src/identity.d.ts",
      "import": "./dist/src/identity.js",
      "require": "./dist/src/identity.js",
      "default": "./dist/src/identity.js"
    },
    "./channels": {
      "types": "./dist/src/dto.d.ts",
      "import": "./dist/src/dto.js",
      "require": "./dist/src/dto.js",
      "default": "./dist/src/dto.js"
    },
    "./version": {
      "types": "./dist/src/version.d.ts",
      "import": "./dist/src/version.js",
      "require": "./dist/src/version.js",
      "default": "./dist/src/version.js"
    },
    "./capture-scroll": {
      "types": "./dist/src/captureScroll.d.ts",
      "import": "./dist/src/captureScroll.js",
      "require": "./dist/src/captureScroll.js",
      "default": "./dist/src/captureScroll.js"
    },
    "./browser-validator": {
      "types": "./dist/src/browserValidator.d.ts",
      "default": "./dist/src/browserValidator.js"
    },
    "./schema": "./schema/protocol.schema.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "node scripts/build-browser-validator.mjs && node scripts/write-build-fingerprint.mjs",
    "test:exports": "node --test scripts/package-exports.test.mjs",
    "test:source-fingerprint": "node --test scripts/source-fingerprint.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test scripts/package-exports.test.mjs dist/test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
