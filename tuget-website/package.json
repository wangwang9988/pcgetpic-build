{
  "name": "tuget-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node ./scripts/generate-urls.mjs && npm run package:public",
    "generate": "nuxt generate && node ./scripts/generate-urls.mjs",
    "generate:urls": "node ./scripts/generate-urls.mjs",
    "push:baidu": "node ./scripts/baidu-push.mjs",
    "push:indexnow": "node ./scripts/bing-indexnow.mjs",
    "push:all": "node ./scripts/baidu-push.mjs && node ./scripts/bing-indexnow.mjs",
    "package:public": "pwsh -NoProfile -File ./scripts/package-public.ps1",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "nuxt": "4.5.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.3",
    "vite-plugin-vue-tracer": "^1.5.0",
    "vue-tsc": "^3.3.9"
  }
}
