# 本地开发时由 Nuxt 代理到该服务；生产环境建议由 Nginx 将同域 /api/ 反代至服务端。
NUXT_API_TARGET=http://127.0.0.1:3001

# 浏览器端默认使用同域 API，通常无需修改。
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_SITE_URL=https://tuget.yueding168.com

# TuGet（图个吉利）客户端专属微软商店地址。
# 默认值已在代码中预置为 TuGet 已分配的 Store 地址 (9N5Q5LHZ5R8H)：
# https://apps.microsoft.com/detail/9N5Q5LHZ5R8H
# 注意：严禁将本环境变量配置为当图的旧 ID (9P5S2FVP6CR5)！
NUXT_PUBLIC_MICROSOFT_STORE_URL=https://apps.microsoft.com/detail/9N5Q5LHZ5R8H

NUXT_PUBLIC_SUPPORT_EMAIL=service@yueding168.com

# 百度统计站点 ID（hm.js? 后面那串）。留空则使用内置默认值，设为空格以外的值可覆盖。
NUXT_PUBLIC_BAIDU_HM_ID=9fc9f7d6002f1d84c5d0798062ffdf7f

# 官网运营主体与工信部备案号。默认值与现有当图官网备案信息一致。
NUXT_PUBLIC_OPERATOR_NAME=上海跃町网络科技有限公司
NUXT_PUBLIC_ICP_NUMBER=沪ICP备16021076号-3

# Google Search Console 站长验证码（https://search.google.com/search-console → 设置 → 所有权验证 → HTML 标记中 content 的值）。
# 留空则不输出 google-site-verification 标签。
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing 站长工具验证码（https://www.bing.com/webmasters → 验证 → meta 标记中 msvalidate.01 的 content 值）。
# 留空则不输出 msvalidate.01 标签。
NUXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow 协议密钥。需与 public/<key>.txt 文件名及文件内容保持一致（当前仓库预置密钥为
# b3a82f4c9d1e4a7f8c2d5e6a9b0c3d4e，对应 public/b3a82f4c9d1e4a7f8c2d5e6a9b0c3d4e.txt）。
# 更换密钥时请同步替换 public/ 下的密钥文件，构建后一起发布。
NUXT_PUBLIC_INDEXNOW_KEY=b3a82f4c9d1e4a7f8c2d5e6a9b0c3d4e

# 百度搜索资源平台普通收录 API 推送准入密钥（ziyuan.baidu.com → 搜索服务 → 普通收录 → API 推送）。
# 仅本地推送使用，不会进入静态产物。
BAIDU_PUSH_TOKEN=
